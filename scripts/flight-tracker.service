[Unit]
Description=Flight Tracker Complete System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/flight-tracker
ExecStart=/usr/bin/make -C /home/pi/flight-tracker pi
ExecStop=/usr/bin/make -C /home/pi/flight-tracker stop
Restart=always
RestartSec=10
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
